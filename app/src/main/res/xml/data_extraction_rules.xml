<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="joe-browser/profiles/" />
        <include domain="file" path="joe-browser/settings.json" />
        <include domain="file" path="joe-browser/proxies.json" />
        <include domain="file" path="joe-browser/extensions.json" />
        <exclude domain="file" path="joe-browser/browsers/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="joe-browser/" />
        <exclude domain="file" path="joe-browser/browsers/" />
    </device-transfer>
</data-extraction-rules>
